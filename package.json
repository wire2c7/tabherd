{
  "name": "tabherd",
  "version": "0.1.0",
  "private": true,
  "description": "TabHerd - Auto Tab Groups",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run --passWithNoTests",
    "e2e": "wxt build && playwright test -c e2e",
    "e2e:extension-id": "e2e/mcp-extension-id.sh",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@logtape/logtape": "2.4.2",
    "preact": "11.0.2",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.3",
    "@playwright/mcp": "0.0.83",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  }
}
